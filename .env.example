# Local development only. Keep this file's names aligned with compose.yaml.
POSTGRES_USER=connectsphere
POSTGRES_PASSWORD=connectsphere_local
POSTGRES_DB=connectsphere
POSTGRES_PORT=5432
DATABASE_URL=postgresql://connectsphere:connectsphere_local@127.0.0.1:5432/connectsphere
API_HOST=127.0.0.1
API_PORT=3000
# Vite reads this in its server process; no database secrets belong in VITE_*.
API_PROXY_TARGET=http://127.0.0.1:3000
