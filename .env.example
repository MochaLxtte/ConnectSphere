# Supabase Dashboard > Connect > Session pooler (port 5432, IPv4 compatible).
# Replace placeholders and URL-encode the database password. Never expose this in VITE_*.
# Add &sslrootcert=URL_ENCODED_ABSOLUTE_CA_PATH if the server CA is not already trusted.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Optional direct/session connection for migrations and development seed; defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Use a separate database/project for integration tests, never the shared development database.
TEST_DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3000
# Vite reads this in its server process; no database secrets belong in VITE_*.
API_PROXY_TARGET=http://127.0.0.1:3000
