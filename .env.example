# Supabase Dashboard > Connect > Session pooler (port 5432, IPv4 compatible).
# Copy the actual username and pooler host from the dashboard; URL-encode the password.
# Download the project's root certificate and keep it outside the repository.
# Use your own URL-encoded absolute certificate path; see database/README.md for examples.
# Replace every placeholder. Never expose DATABASE_URL in VITE_* variables.
DATABASE_URL="postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=ENCODED_ABSOLUTE_CA_PATH"
# Optional same-project direct/session connection for migrations and development seed.
# Include the TLS/certificate settings above if set; blank defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=
# Use a separate database/project for integration tests, never the shared development database.
TEST_DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=3000
# Vite reads this in its server process; no database secrets belong in VITE_*.
API_PROXY_TARGET=http://127.0.0.1:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Optional backend-only signing secret for projects using legacy HS256 tokens.
# Leave blank when verifying against the project's asymmetric signing keys (JWKS).
SUPABASE_JWT_SECRET=
