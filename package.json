{
  "name": "connectsphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "submission:prepare": "node scripts/prepare-submission.mjs",
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev -w @connectsphere/backend\" \"npm run dev -w @connectsphere/frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "tsc -p tsconfig.tools.json && npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "pg": "^8.16.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
